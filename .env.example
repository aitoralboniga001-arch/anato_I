# AI is intentionally disabled for the current MVP. Set both flags to true
# only when the tutor is ready to be enabled in a later release.
AI_TUTOR_ENABLED=false
NEXT_PUBLIC_AI_TUTOR_ENABLED=false

# Optional: enables the live Gemini tutor route.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model override. Default: gemini-3.5-flash-lite
AI_MODEL=gemini-3.5-flash-lite

# Kimu, the chat assistant that takes the student to the right step of the simulator.
# Get a key at console.groq.com; in Vercel add it under Settings → Environment Variables and redeploy.
# Without it Kimu still works: it answers from the notes search alone.
GROQ_API_KEY=
# Optional model override. Default: qwen/qwen3.8-27b
KIMU_MODEL=qwen/qwen3.8-27b
